# Copy to .env and fill in. Never commit real values.

# --- chain -------------------------------------------------------------------
RECON_CHAIN_MODE=mock
RECON_RPC_URL=https://rpc-testnet.gokite.ai/
RECON_CHAIN_ID=2368
# Kite testnet payment token from the Service Provider Guide
# (https://docs.gokite.ai/kite-agent-passport/service-provider-guide);
# re-verify on https://testnet.kitescan.ai before trusting it.
RECON_TOKEN_ADDRESS=0x0fF5393387ad2f9f691FD6Fd28e07E3969e27e63
# Fallback only: `probe`/reports read decimals() from the contract (this token
# answered 18 on 2026-11-22) and use this value when the call fails.
RECON_TOKEN_DECIMALS=18
RECON_MIN_CONFIRMATIONS=1

# --- ledger ------------------------------------------------------------------
RECON_LEDGER_KIND=file
RECON_LEDGER_PATH=fixtures/ledger.jsonl
RECON_LEDGER_URL=
RECON_LEDGER_TOKEN_ENV=RECON_LEDGER_TOKEN
# Only used when RECON_LEDGER_KIND=http
RECON_LEDGER_TOKEN=

# --- reconcile ---------------------------------------------------------------
RECON_RECEIVER=0x2222222222222222222222222222222222222222
RECON_WINDOW_MINUTES=60
RECON_MAX_RECORDS=500
RECON_LOOKBACK_BLOCKS=2000

# --- server ------------------------------------------------------------------
RECON_BIND=127.0.0.1:8081
RECON_API_TOKEN=
RECON_REFRESH_SECONDS=30

# --- mock --------------------------------------------------------------------
RECON_MOCK_FIXTURE=fixtures/chain_mock.json

# --- logging -----------------------------------------------------------------
RUST_LOG=info
